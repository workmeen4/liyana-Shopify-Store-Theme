{% comment %}
  Bagkin Blog Slider Section
  - Displays recent blog posts in a carousel
  - Fully mobile responsive
{% endcomment %}

<style>
  :root {
    --bagkin-font: 'Jost', sans-serif;
  }

  .bagkin-blog-section {
    padding: 60px 5%;
    font-family: var(--bagkin-font);
    background-color: #fff;
    max-width: 1400px;
    margin: 0 auto;
  }

  .bagkin-blog-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .bagkin-blog-heading {
    font-size: 32px;
    font-weight: 600;
    text-transform: uppercase;
    margin: 0;
    color: #000;
  }

  /* --- Carousel --- */
  .bagkin-blog-carousel-wrapper {
    position: relative;
    width: 100%;
  }

  .bagkin-blog-carousel {
    overflow: hidden;
    width: 100%;
  }

  .bagkin-blog-track {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }

  /* --- Card --- */
  .bagkin-blog-slide {
    flex: 0 0 33.333%;
    max-width: 33.333%;
    padding: 0 15px;
    box-sizing: border-box;
  }

  .bagkin-blog-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .bagkin-blog-img-wrapper {
    width: 100%;
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    margin-bottom: 25px;
  }

  .bagkin-blog-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .bagkin-blog-card:hover .bagkin-blog-img {
    transform: scale(1.05);
  }

  .bagkin-blog-date {
    font-size: 12px;
    color: #888;
    text-transform: capitalize;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }

  .bagkin-blog-title {
    font-size: 20px;
    font-weight: 600;
    color: #000;
    text-decoration: none;
    margin: 0 0 15px 0;
    line-height: 1.4;
    transition: color 0.3s ease;
  }

  .bagkin-blog-title:hover {
    color: {{ section.settings.accent_color | default: '#F0950A' }};
  }

  .bagkin-blog-excerpt {
    font-size: 14px;
    color: #666;
    line-height: 1.6;
    margin: 0 0 25px 0;
  }

  .bagkin-blog-btn {
    display: inline-block;
    background-color: #000;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 12px 30px;
    text-decoration: none;
    border: 1px solid #000;
    transition: all 0.3s ease;
  }

  .bagkin-blog-btn:hover {
    background-color: transparent;
    color: #000;
  }

  /* --- Navigation Arrows --- */
  .bagkin-blog-arrow {
    position: absolute;
    top: 35%; /* roughly centered on the image */
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    background-color: rgba(0,0,0,0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    transition: background-color 0.3s ease;
    border: none;
    color: #fff;
  }

  .bagkin-blog-arrow:hover {
    background-color: rgba(0,0,0,0.8);
  }

  .bagkin-blog-prev { left: 5px; }
  .bagkin-blog-next { right: 5px; }

  .bagkin-blog-arrow svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  /* --- Responsive --- */
  @media screen and (max-width: 991px) {
    .bagkin-blog-slide {
      flex: 0 0 50%;
      max-width: 50%;
    }
  }

  @media screen and (max-width: 767px) {
    .bagkin-blog-section {
      padding: 40px 5%;
    }
    .bagkin-blog-slide {
      flex: 0 0 100%;
      max-width: 100%;
    }
    .bagkin-blog-arrow {
      top: 50%;
    }
  }
</style>

<section class="bagkin-blog-section" id="bagkinBlog-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <div class="bagkin-blog-header">
      <h2 class="bagkin-blog-heading">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="bagkin-blog-carousel-wrapper">
    <!-- Arrows -->
    <button class="bagkin-blog-arrow bagkin-blog-prev" id="blogPrev-{{ section.id }}" aria-label="Previous">
      <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="bagkin-blog-arrow bagkin-blog-next" id="blogNext-{{ section.id }}" aria-label="Next">
      <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

    <div class="bagkin-blog-carousel">
      <div class="bagkin-blog-track" id="blogTrack-{{ section.id }}">
        
        {% assign blog = blogs[section.settings.blog] %}
        
        {% if blog.articles.size > 0 %}
          {% for article in blog.articles limit: section.settings.post_limit %}
            <div class="bagkin-blog-slide">
              <div class="bagkin-blog-card">
                <a href="{{ article.url }}" class="bagkin-blog-img-wrapper">
                  {% if article.image %}
                    <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" class="bagkin-blog-img" loading="lazy">
                  {% else %}
                    <div style="width:100%; height:100%; background:#f5f5f5;"></div>
                  {% endif %}
                </a>
                
                <div class="bagkin-blog-date">
                  {{ article.published_at | date: "%B %d, %Y" }}
                </div>
                
                <a href="{{ article.url }}" class="bagkin-blog-title">
                  {{ article.title }}
                </a>
                
                <p class="bagkin-blog-excerpt">
                  {% if article.excerpt != blank %}
                    {{ article.excerpt | strip_html | truncatewords: 20 }}
                  {% else %}
                    {{ article.content | strip_html | truncatewords: 20 }}
                  {% endif %}
                </p>
                
                <a href="{{ article.url }}" class="bagkin-blog-btn">Read More</a>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <!-- Dummy Content -->
          {% for i in (1..3) %}
            <div class="bagkin-blog-slide">
              <div class="bagkin-blog-card">
                <a href="#" class="bagkin-blog-img-wrapper">
                  <div style="width:100%; height:100%; background:#eee; display:flex; align-items:center; justify-content:center; color:#999;">Dummy Image</div>
                </a>
                <div class="bagkin-blog-date">November 16, 2025</div>
                <a href="#" class="bagkin-blog-title">Good Products For Lovely Girls</a>
                <p class="bagkin-blog-excerpt">These are the people who make your life easier. Large tiles were arranged on the counter top plate near...</p>
                <a href="#" class="bagkin-blog-btn">Read More</a>
              </div>
            </div>
          {% endfor %}
        {% endif %}
        
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const track = document.getElementById('blogTrack-{{ section.id }}');
    const slides = track.querySelectorAll('.bagkin-blog-slide');
    const prevBtn = document.getElementById('blogPrev-{{ section.id }}');
    const nextBtn = document.getElementById('blogNext-{{ section.id }}');
    
    if(!track || slides.length === 0) return;

    let currentIndex = 0;
    
    // Determine how many slides are visible based on screen width
    function getVisibleSlides() {
      if (window.innerWidth <= 767) return 1;
      if (window.innerWidth <= 991) return 2;
      return 3;
    }

    let visibleSlides = getVisibleSlides();
    let maxIndex = Math.max(0, slides.length - visibleSlides);

    // Hide arrows if not enough slides
    function checkArrows() {
      if (slides.length <= visibleSlides) {
        if(prevBtn) prevBtn.style.display = 'none';
        if(nextBtn) nextBtn.style.display = 'none';
      } else {
        if(prevBtn) prevBtn.style.display = 'flex';
        if(nextBtn) nextBtn.style.display = 'flex';
      }
    }
    
    checkArrows();

    window.addEventListener('resize', () => {
      visibleSlides = getVisibleSlides();
      maxIndex = Math.max(0, slides.length - visibleSlides);
      
      // Prevent index out of bounds on resize
      if (currentIndex > maxIndex) {
        currentIndex = maxIndex;
      }
      checkArrows();
      updateCarousel();
    });

    function updateCarousel() {
      // Calculate percentage to move
      // e.g. If 3 visible slides, each is 33.333% wide.
      const slideWidth = 100 / visibleSlides;
      track.style.transform = `translateX(-${currentIndex * slideWidth}%)`;
    }

    function nextSlide() {
      if (currentIndex < maxIndex) {
        currentIndex++;
      } else {
        currentIndex = 0; // Loop back
      }
      updateCarousel();
    }

    function prevSlide() {
      if (currentIndex > 0) {
        currentIndex--;
      } else {
        currentIndex = maxIndex; // Loop back to end
      }
      updateCarousel();
    }

    if(nextBtn) nextBtn.addEventListener('click', nextSlide);
    if(prevBtn) prevBtn.addEventListener('click', prevSlide);

    // Touch Swipe Support for Mobile
    let touchStartX = 0;
    let touchEndX = 0;

    track.addEventListener('touchstart', e => {
      touchStartX = e.changedTouches[0].screenX;
    }, {passive: true});

    track.addEventListener('touchend', e => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, {passive: true});

    function handleSwipe() {
      if (touchEndX < touchStartX - 50) nextSlide();
      if (touchEndX > touchStartX + 50) prevSlide();
    }
  });
</script>

{% schema %}
{
  "name": "Bagkin Blog Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest News"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Total Posts to Load",
      "default": 6
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Title Hover Color",
      "default": "#F0950A"
    }
  ],
  "presets": [
    {
      "name": "Bagkin Blog Slider"
    }
  ]
}
{% endschema %}
