{% comment %}
  Bagkin Custom Header & Hero Slideshow Section
  - Mobile friendly & 100% responsive
  - Custom font family Jost loaded via Google Fonts
  - Primary color #F0950A, Secondary color Black (#000000)
  - Smooth animation sticky header on scroll
  - Customizable logo width & height in theme editor
  - Toggle switches to enable/disable Search, Account, Wishlist & Cart icons
  - Mobile mode: options to clean up actions and show only Search & Cart (Add to Cart)
  - 5 Editable slides with customizable image, subtitle, title, description, button text & link
  - Full theme editor schema settings
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">

{% style %}
  :root {
    --bagkin-font: 'Jost', sans-serif;
    --bagkin-primary: {{ section.settings.primary_color | default: '#F0950A' }};
    --bagkin-secondary: {{ section.settings.secondary_color | default: '#000000' }};
    --bagkin-bg: {{ section.settings.header_bg_color | default: '#EAE6DF' }};
    --bagkin-text: #333333;
  }

  .bagkin-wrapper * {
    font-family: var(--bagkin-font);
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .bagkin-wrapper {
    width: 100%;
    position: relative;
    background-color: var(--bagkin-bg);
    overflow: hidden;
  }

  /* --- HEADER STYLES --- */
  .bagkin-header-container {
    width: 100%;
    position: relative;
    z-index: 100;
  }

  .bagkin-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 5%;
    width: 100%;
    background-color: transparent;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Sticky Header State */
  .bagkin-header.is-sticky {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: {{ section.settings.sticky_header_bg | default: '#ffffff' }};
    color: {{ section.settings.sticky_header_text_color | default: '#000000' }};
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    padding: 14px 5%;
    animation: bagkinSlideDown 0.4s ease forwards;
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .bagkin-header.is-sticky .bagkin-nav-item a,
  .bagkin-header.is-sticky .bagkin-icon-btn,
  .bagkin-header.is-sticky .bagkin-logo-text,
  .bagkin-header.is-sticky .bagkin-hamburger {
    color: {{ section.settings.sticky_header_text_color | default: '#000000' }};
  }

  @keyframes bagkinSlideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Logo Styling */
  .bagkin-logo a {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .bagkin-logo-img {
    width: {{ section.settings.logo_width | default: 160 }}px;
    height: {% if section.settings.logo_height != blank %}{{ section.settings.logo_height }}px{% else %}auto{% endif %};
    max-width: 100%;
    object-fit: contain;
  }

  .bagkin-logo-text {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--bagkin-secondary);
    text-transform: uppercase;
  }

  /* Navigation Menu */
  .bagkin-nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .bagkin-nav-list {
    display: flex;
    list-style: none;
    gap: 32px;
    align-items: center;
  }

  .bagkin-nav-item a {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--bagkin-secondary);
    text-decoration: none;
    position: relative;
    padding: 4px 0;
    transition: color 0.3s ease;
  }

  .bagkin-nav-item a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--bagkin-primary);
    transition: width 0.3s ease;
  }

  .bagkin-nav-item a:hover {
    color: var(--bagkin-primary);
  }

  .bagkin-nav-item a:hover::after {
    width: 100%;
  }

  /* Header Icons */
  .bagkin-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .bagkin-icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--bagkin-secondary);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    transition: transform 0.2s ease, color 0.3s ease;
    text-decoration: none;
  }

  .bagkin-icon-btn:hover {
    color: var(--bagkin-primary);
    transform: translateY(-2px);
  }

  .bagkin-icon-btn svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
  }

  .bagkin-cart-badge {
    position: absolute;
    top: -2px;
    right: -4px;
    background-color: var(--bagkin-primary);
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Mobile Hamburger */
  .bagkin-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: var(--bagkin-secondary);
  }

  .bagkin-hamburger svg {
    width: 26px;
    height: 26px;
  }

  /* Mobile Drawer Menu */
  .bagkin-mobile-menu {
    position: fixed;
    top: 0;
    left: -100%;
    width: 80%;
    max-width: 320px;
    height: 100vh;
    background-color: #ffffff;
    z-index: 1000;
    box-shadow: 4px 0 25px rgba(0, 0, 0, 0.15);
    transition: left 0.4s ease;
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
  }

  .bagkin-mobile-menu.is-active {
    left: 0;
  }

  .bagkin-mobile-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-bottom: 15px;
    border-bottom: 1px solid #eee;
  }

  .bagkin-close-btn {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: var(--bagkin-secondary);
  }

  .bagkin-mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .bagkin-mobile-nav a {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--bagkin-secondary);
    text-decoration: none;
  }

  .bagkin-mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .bagkin-mobile-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* --- BANNER SLIDESHOW STYLES --- */
  .bagkin-hero-slider {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 90px);
    display: flex;
    align-items: center;
  }

  .bagkin-slides-container {
    display: flex;
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .bagkin-slide {
    min-width: 100%;
    display: flex;
    align-items: center;
    padding: 40px 8%;
    gap: 40px;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .bagkin-slide.is-active {
    opacity: 1;
  }

  .bagkin-slide-media {
    flex: 1.1;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .bagkin-slide-img {
    max-width: 100%;
    max-height: 520px;
    object-fit: contain;
    filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.08));
    transition: transform 0.7s ease;
  }

  .bagkin-slide.is-active .bagkin-slide-img {
    transform: scale(1.02);
  }

  .bagkin-slide-content {
    flex: 0.9;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 20px;
  }

  .bagkin-subtitle {
    font-size: 18px;
    font-weight: 500;
    color: #666666;
    margin-bottom: 12px;
    letter-spacing: 0.5px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.5s ease 0.2s;
  }

  .bagkin-title {
    font-size: 54px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--bagkin-secondary);
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0;
    transform: translateY(25px);
    transition: all 0.5s ease 0.3s;
  }

  .bagkin-description {
    font-size: 15px;
    line-height: 1.6;
    color: #777777;
    margin-bottom: 32px;
    max-width: 440px;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.5s ease 0.4s;
  }

  .bagkin-btn {
    display: inline-block;
    padding: 16px 42px;
    background-color: var(--bagkin-secondary);
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 28px;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    opacity: 0;
    transform: translateY(35px);
    transition: all 0.5s ease 0.5s;
  }

  .bagkin-btn:hover {
    background-color: var(--bagkin-primary);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(240, 149, 10, 0.3);
  }

  /* Slide Active Animations */
  .bagkin-slide.is-active .bagkin-subtitle,
  .bagkin-slide.is-active .bagkin-title,
  .bagkin-slide.is-active .bagkin-description,
  .bagkin-slide.is-active .bagkin-btn {
    opacity: 1;
    transform: translateY(0);
  }

  /* Slider Dots Pagination */
  .bagkin-dots {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 10;
  }

  .bagkin-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #bbb;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .bagkin-dot.is-active {
    background-color: var(--bagkin-secondary);
    transform: scale(1.2);
  }

  /* Slider Arrows */
  .bagkin-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.7);
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    color: var(--bagkin-secondary);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .bagkin-arrow:hover {
    background-color: var(--bagkin-primary);
    color: #ffffff;
  }

  .bagkin-arrow--prev {
    left: 20px;
  }

  .bagkin-arrow--next {
    right: 20px;
  }

  /* --- RESPONSIVE MEDIA QUERIES --- */
  @media screen and (max-width: 991px) {
    .bagkin-nav {
      display: none;
    }

    .bagkin-hamburger {
      display: block;
    }

    /* Mobile specific icon rules */
    {% if section.settings.mobile_show_search_cart_only %}
      .bagkin-icon-account,
      .bagkin-icon-wishlist {
        display: none !important;
      }
    {% endif %}

    .bagkin-logo-img {
      width: {{ section.settings.mobile_logo_width | default: 120 }}px;
    }

    .bagkin-hero-slider {
      min-height: auto;
      padding-top: 20px;
      padding-bottom: 60px;
    }

    .bagkin-slide {
      flex-direction: column;
      padding: 20px 5%;
      text-align: center;
    }

    .bagkin-slide-content {
      align-items: center;
      padding-left: 0;
      margin-top: 20px;
    }

    .bagkin-title {
      font-size: 36px;
    }

    .bagkin-slide-img {
      max-height: 340px;
    }

    .bagkin-arrow {
      width: 36px;
      height: 36px;
    }
  }

  @media screen and (max-width: 480px) {
    .bagkin-header {
      padding: 16px 4%;
    }

    .bagkin-logo-text {
      font-size: 24px;
    }

    .bagkin-title {
      font-size: 28px;
    }

    .bagkin-subtitle {
      font-size: 15px;
    }

    .bagkin-description {
      font-size: 13px;
    }

    .bagkin-btn {
      padding: 12px 30px;
      font-size: 12px;
    }

    .bagkin-slide-img {
      max-height: 260px;
    }
  }
{% endstyle %}

<div class="bagkin-wrapper">
  <!-- HEADER -->
  <div class="bagkin-header-container">
    <header class="bagkin-header" id="bagkinHeader">
      <div class="bagkin-logo">
        <a href="{{ routes.root_url }}">
          {% if section.settings.logo_image != blank %}
            <img
              src="{{ section.settings.logo_image | image_url: width: 600 }}"
              alt="{{ shop.name }}"
              class="bagkin-logo-img"
              loading="eager"
            >
          {% else %}
            <span class="bagkin-logo-text">{{ section.settings.logo_text | default: shop.name }}</span>
          {% endif %}
        </a>
      </div>

      <nav class="bagkin-nav">
        <ul class="bagkin-nav-list">
          {% assign main_menu = linklists[section.settings.menu_linklist] %}
          {% if main_menu.links.size > 0 %}
            {% for link in main_menu.links %}
              <li class="bagkin-nav-item">
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {% endfor %}
          {% else %}
            <li class="bagkin-nav-item"><a href="#">HOME</a></li>
            <li class="bagkin-nav-item"><a href="#">SHOPS</a></li>
            <li class="bagkin-nav-item"><a href="#">PRODUCTS</a></li>
            <li class="bagkin-nav-item"><a href="#">BLOG</a></li>
            <li class="bagkin-nav-item"><a href="#">PAGES</a></li>
          {% endif %}
        </ul>
      </nav>

      <div class="bagkin-actions">
        <!-- Search Icon -->
        {% if section.settings.show_search_icon %}
          <a href="{{ routes.search_url }}" class="bagkin-icon-btn bagkin-icon-search" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </a>
        {% endif %}

        <!-- Account Icon -->
        {% if section.settings.show_account_icon %}
          <a href="{{ routes.account_url }}" class="bagkin-icon-btn bagkin-icon-account" aria-label="Account">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </a>
        {% endif %}

        <!-- Wishlist / Heart Icon -->
        {% if section.settings.show_wishlist_icon %}
          <a href="#" class="bagkin-icon-btn bagkin-icon-wishlist" aria-label="Wishlist">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </a>
        {% endif %}

        <!-- Cart Icon with Badge -->
        {% if section.settings.show_cart_icon %}
          <a href="{{ routes.cart_url }}" class="bagkin-icon-btn bagkin-icon-cart" aria-label="Cart">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span class="bagkin-cart-badge">{{ cart.item_count | default: 0 }}</span>
          </a>
        {% endif %}

        <!-- Mobile Hamburger -->
        <button class="bagkin-hamburger" id="bagkinHamburger" aria-label="Toggle Menu">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>
  </div>

  <!-- MOBILE DRAWER MENU -->
  <div class="bagkin-mobile-overlay" id="bagkinOverlay"></div>
  <div class="bagkin-mobile-menu" id="bagkinMobileMenu">
    <div class="bagkin-mobile-header">
      <span class="bagkin-logo-text">{{ section.settings.logo_text | default: shop.name }}</span>
      <button class="bagkin-close-btn" id="bagkinCloseBtn">&times;</button>
    </div>
    <nav class="bagkin-mobile-nav">
      {% assign main_menu = linklists[section.settings.menu_linklist] %}
      {% if main_menu.links.size > 0 %}
        {% for link in main_menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="#">HOME</a>
        <a href="#">SHOPS</a>
        <a href="#">PRODUCTS</a>
        <a href="#">BLOG</a>
        <a href="#">PAGES</a>
      {% endif %}
    </nav>
  </div>

  <!-- SLIDESHOW HERO BANNER -->
  <div class="bagkin-hero-slider" id="bagkinSlider">
    <div class="bagkin-slides-container" id="bagkinSlidesContainer">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="bagkin-slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
            <div class="bagkin-slide-media">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 1000 }}"
                  alt="{{ block.settings.title | escape }}"
                  class="bagkin-slide-img"
                  loading="eager"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'bagkin-slide-img' }}
              {% endif %}
            </div>
            <div class="bagkin-slide-content">
              {% if block.settings.subtitle != blank %}
                <p class="bagkin-subtitle">{{ block.settings.subtitle }}</p>
              {% endif %}
              {% if block.settings.title != blank %}
                <h1 class="bagkin-title">{{ block.settings.title }}</h1>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="bagkin-description">{{ block.settings.description }}</p>
              {% endif %}
              {% if block.settings.button_text != blank %}
                <a href="{{ block.settings.button_link | default: '#' }}" class="bagkin-btn">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Placeholder Slides if no blocks added yet -->
        {% for i in (1..5) %}
          <div class="bagkin-slide {% if forloop.first %}is-active{% endif %}">
            <div class="bagkin-slide-media">
              {{ 'product-1' | placeholder_svg_tag: 'bagkin-slide-img' }}
            </div>
            <div class="bagkin-slide-content">
              <p class="bagkin-subtitle">Come reworked for 2020</p>
              <h1 class="bagkin-title">ORIGINAL BAG {{ i }}</h1>
              <p class="bagkin-description">
                The upper is made of animal free & weather resistant cordura nylon and micro fiber.
              </p>
              <a href="#" class="bagkin-btn">SHOP NOW</a>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Arrow Controls -->
    {% if section.settings.show_arrows %}
      <button class="bagkin-arrow bagkin-arrow--prev" id="bagkinPrev" aria-label="Previous Slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="bagkin-arrow bagkin-arrow--next" id="bagkinNext" aria-label="Next Slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    <!-- Dots Pagination -->
    <div class="bagkin-dots" id="bagkinDots">
      {% assign slide_count = section.blocks.size %}
      {% if slide_count == 0 %}{% assign slide_count = 5 %}{% endif %}
      {% for i in (1..slide_count) %}
        <button class="bagkin-dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // --- STICKY HEADER LOGIC ---
    const header = document.getElementById('bagkinHeader');
    window.addEventListener('scroll', function () {
      if (window.scrollY > 80) {
        header.classList.add('is-sticky');
      } else {
        header.classList.remove('is-sticky');
      }
    });

    // --- MOBILE MENU LOGIC ---
    const hamburger = document.getElementById('bagkinHamburger');
    const closeBtn = document.getElementById('bagkinCloseBtn');
    const mobileMenu = document.getElementById('bagkinMobileMenu');
    const overlay = document.getElementById('bagkinOverlay');

    function openMobileMenu() {
      mobileMenu.classList.add('is-active');
      overlay.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
      mobileMenu.classList.remove('is-active');
      overlay.classList.remove('is-active');
      document.body.style.overflow = '';
    }

    if (hamburger) hamburger.addEventListener('click', openMobileMenu);
    if (closeBtn) closeBtn.addEventListener('click', closeMobileMenu);
    if (overlay) overlay.addEventListener('click', closeMobileMenu);

    // --- SLIDESHOW SLIDER LOGIC ---
    const container = document.getElementById('bagkinSlidesContainer');
    const slides = document.querySelectorAll('.bagkin-slide');
    const dots = document.querySelectorAll('.bagkin-dot');
    const prevBtn = document.getElementById('bagkinPrev');
    const nextBtn = document.getElementById('bagkinNext');
    let currentIndex = 0;
    const totalSlides = slides.length;
    let autoplayTimer = null;
    const autoplayInterval = {{ section.settings.autoplay_speed | default: 5000 }};

    function updateSlider(index) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentIndex = index;

      container.style.transform = `translateX(-${currentIndex * 100}%)`;

      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.add('is-active');
        } else {
          slide.classList.remove('is-active');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });
    }

    function nextSlide() {
      updateSlider(currentIndex + 1);
    }

    function prevSlide() {
      updateSlider(currentIndex - 1);
    }

    if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); resetAutoplay(); });
    if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); resetAutoplay(); });

    dots.forEach((dot) => {
      dot.addEventListener('click', function () {
        const index = parseInt(this.getAttribute('data-index'));
        updateSlider(index);
        resetAutoplay();
      });
    });

    {% if section.settings.enable_autoplay %}
      function startAutoplay() {
        autoplayTimer = setInterval(nextSlide, autoplayInterval);
      }

      function resetAutoplay() {
        clearInterval(autoplayTimer);
        startAutoplay();
      }

      startAutoplay();

      // Pause on hover
      const sliderEl = document.getElementById('bagkinSlider');
      sliderEl.addEventListener('mouseenter', () => clearInterval(autoplayTimer));
      sliderEl.addEventListener('mouseleave', () => startAutoplay());
    {% endif %}
  });
</script>

