{% comment %}
  Bagkin Hero Slideshow Section
  - Mobile friendly & 100% responsive
  - Custom font family Jost loaded via Google Fonts
  - Primary color #F0950A, Secondary color Black (#000000)
  - 5 Editable slides with customizable image, subtitle, title, description, button text & link
  - Full theme editor schema settings
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">

{% style %}
  :root {
    --bagkin-font: 'Jost', sans-serif;
    --bagkin-primary: {{ section.settings.primary_color | default: '#F0950A' }};
    --bagkin-secondary: {{ section.settings.secondary_color | default: '#000000' }};
    --bagkin-bg: {{ section.settings.banner_bg_color | default: '#EAE6DF' }};
  }

  .bagkin-wrapper * {
    font-family: var(--bagkin-font);
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .bagkin-wrapper {
    width: 100%;
    position: relative;
    background-color: var(--bagkin-bg);
    overflow: hidden;
  }

  /* --- BANNER SLIDESHOW STYLES --- */
  .bagkin-hero-slider {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 90px);
    display: flex;
    align-items: center;
  }

  .bagkin-slides-container {
    display: flex;
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .bagkin-slide {
    min-width: 100%;
    display: flex;
    align-items: center;
    padding: 60px 8%;
    gap: 40px;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .bagkin-slide.is-active {
    opacity: 1;
  }

  .bagkin-slide-media {
    flex: 1.1;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .bagkin-slide-img {
    max-width: 100%;
    max-height: 520px;
    object-fit: contain;
    filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.08));
    transition: transform 0.7s ease;
  }

  .bagkin-slide.is-active .bagkin-slide-img {
    transform: scale(1.02);
  }

  .bagkin-slide-content {
    flex: 0.9;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 20px;
  }

  .bagkin-subtitle {
    font-size: 18px;
    font-weight: 500;
    color: #666666;
    margin-bottom: 12px;
    letter-spacing: 0.5px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.5s ease 0.2s;
  }

  .bagkin-title {
    font-size: 54px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--bagkin-secondary);
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0;
    transform: translateY(25px);
    transition: all 0.5s ease 0.3s;
  }

  .bagkin-description {
    font-size: 15px;
    line-height: 1.6;
    color: #777777;
    margin-bottom: 32px;
    max-width: 440px;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.5s ease 0.4s;
  }

  .bagkin-btn {
    display: inline-block;
    padding: 16px 42px;
    background-color: var(--bagkin-secondary);
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 28px;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    opacity: 0;
    transform: translateY(35px);
    transition: all 0.5s ease 0.5s;
  }

  .bagkin-btn:hover {
    background-color: var(--bagkin-primary);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(240, 149, 10, 0.3);
  }

  /* Slide Active Animations */
  .bagkin-slide.is-active .bagkin-subtitle,
  .bagkin-slide.is-active .bagkin-title,
  .bagkin-slide.is-active .bagkin-description,
  .bagkin-slide.is-active .bagkin-btn {
    opacity: 1;
    transform: translateY(0);
  }

  /* Slider Dots Pagination */
  .bagkin-dots {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 10;
  }

  .bagkin-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #bbb;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .bagkin-dot.is-active {
    background-color: var(--bagkin-secondary);
    transform: scale(1.2);
  }

  /* Slider Arrows */
  .bagkin-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.7);
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    color: var(--bagkin-secondary);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .bagkin-arrow:hover {
    background-color: var(--bagkin-primary);
    color: #ffffff;
  }

  .bagkin-arrow--prev {
    left: 20px;
  }

  .bagkin-arrow--next {
    right: 20px;
  }

  /* --- RESPONSIVE MEDIA QUERIES --- */
  @media screen and (max-width: 991px) {
    .bagkin-hero-slider {
      min-height: auto;
      padding-top: 20px;
      padding-bottom: 60px;
    }

    .bagkin-slide {
      flex-direction: column;
      padding: 30px 5%;
      text-align: center;
    }

    .bagkin-slide-content {
      align-items: center;
      padding-left: 0;
      margin-top: 20px;
    }

    .bagkin-title {
      font-size: 36px;
    }

    .bagkin-slide-img {
      max-height: 340px;
    }

    .bagkin-arrow {
      width: 36px;
      height: 36px;
    }
  }

  @media screen and (max-width: 480px) {
    .bagkin-title {
      font-size: 28px;
    }

    .bagkin-subtitle {
      font-size: 15px;
    }

    .bagkin-description {
      font-size: 13px;
    }

    .bagkin-btn {
      padding: 12px 30px;
      font-size: 12px;
    }

    .bagkin-slide-img {
      max-height: 260px;
    }
  }
{% endstyle %}

<div class="bagkin-wrapper">
  <!-- SLIDESHOW HERO BANNER -->
  <div class="bagkin-hero-slider" id="bagkinBannerSlider">
    <div class="bagkin-slides-container" id="bagkinBannerSlidesContainer">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="bagkin-slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
            <div class="bagkin-slide-media">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 1000 }}"
                  alt="{{ block.settings.title | escape }}"
                  class="bagkin-slide-img"
                  loading="eager"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'bagkin-slide-img' }}
              {% endif %}
            </div>
            <div class="bagkin-slide-content">
              {% if block.settings.subtitle != blank %}
                <p class="bagkin-subtitle">{{ block.settings.subtitle }}</p>
              {% endif %}
              {% if block.settings.title != blank %}
                <h1 class="bagkin-title">{{ block.settings.title }}</h1>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="bagkin-description">{{ block.settings.description }}</p>
              {% endif %}
              {% if block.settings.button_text != blank %}
                <a href="{{ block.settings.button_link | default: '#' }}" class="bagkin-btn">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Placeholder Slides if no blocks added yet -->
        {% for i in (1..5) %}
          <div class="bagkin-slide {% if forloop.first %}is-active{% endif %}">
            <div class="bagkin-slide-media">
              {{ 'product-1' | placeholder_svg_tag: 'bagkin-slide-img' }}
            </div>
            <div class="bagkin-slide-content">
              <p class="bagkin-subtitle">Come reworked for 2020</p>
              <h1 class="bagkin-title">ORIGINAL BAG {{ i }}</h1>
              <p class="bagkin-description">
                The upper is made of animal free & weather resistant cordura nylon and micro fiber.
              </p>
              <a href="#" class="bagkin-btn">SHOP NOW</a>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Arrow Controls -->
    {% if section.settings.show_arrows %}
      <button class="bagkin-arrow bagkin-arrow--prev" id="bagkinBannerPrev" aria-label="Previous Slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="bagkin-arrow bagkin-arrow--next" id="bagkinBannerNext" aria-label="Next Slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    <!-- Dots Pagination -->
    <div class="bagkin-dots" id="bagkinBannerDots">
      {% assign slide_count = section.blocks.size %}
      {% if slide_count == 0 %}{% assign slide_count = 5 %}{% endif %}
      {% for i in (1..slide_count) %}
        <button class="bagkin-dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.getElementById('bagkinBannerSlidesContainer');
    const slides = document.querySelectorAll('#bagkinBannerSlider .bagkin-slide');
    const dots = document.querySelectorAll('#bagkinBannerDots .bagkin-dot');
    const prevBtn = document.getElementById('bagkinBannerPrev');
    const nextBtn = document.getElementById('bagkinBannerNext');
    let currentIndex = 0;
    const totalSlides = slides.length;
    let autoplayTimer = null;
    const autoplayInterval = {{ section.settings.autoplay_speed | default: 5000 }};

    if (!container || slides.length === 0) return;

    function updateSlider(index) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentIndex = index;

      container.style.transform = `translateX(-${currentIndex * 100}%)`;

      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.add('is-active');
        } else {
          slide.classList.remove('is-active');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });
    }

    function nextSlide() {
      updateSlider(currentIndex + 1);
    }

    function prevSlide() {
      updateSlider(currentIndex - 1);
    }

    if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); resetAutoplay(); });
    if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); resetAutoplay(); });

    dots.forEach((dot) => {
      dot.addEventListener('click', function () {
        const index = parseInt(this.getAttribute('data-index'));
        updateSlider(index);
        resetAutoplay();
      });
    });

    {% if section.settings.enable_autoplay %}
      function startAutoplay() {
        autoplayTimer = setInterval(nextSlide, autoplayInterval);
      }

      function resetAutoplay() {
        clearInterval(autoplayTimer);
        startAutoplay();
      }

      startAutoplay();

      const sliderEl = document.getElementById('bagkinBannerSlider');
      if (sliderEl) {
        sliderEl.addEventListener('mouseenter', () => clearInterval(autoplayTimer));
        sliderEl.addEventListener('mouseleave', () => startAutoplay());
      }
    {% endif %}
  });
</script>

{% schema %}
{
  "name": "Bagkin Banner Slideshow",
  "settings": [
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#F0950A"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Secondary Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "banner_bg_color",
      "label": "Banner Background Color",
      "default": "#EAE6DF"
    },
    {
      "type": "header",
      "content": "Banner Slideshow Settings"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Auto Slide",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3000,
      "max": 9000,
      "step": 1000,
      "unit": "ms",
      "label": "Autoplay Change Interval",
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Slide",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Tagline",
          "default": "Come reworked for 2020"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Main Heading",
          "default": "ORIGINAL BAG"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description Text",
          "default": "The upper is made of animal free & weather resistant cordura nylon and micro fiber."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bagkin Banner Slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
