{% comment %}
  Bagkin Best Seller / Collection Products Section
  - Custom Collection Grid Section with clean modern aesthetic
  - Quick View Modal Popup with smooth fade & scale animation
  - Product Color Variant Swatches below card & inside Quick View modal
  - Stock scarcity progress bar ("HURRY UP! ONLY X LEFT IN STOCK")
  - Quantity selector, Add to Cart & Buy It Now buttons
  - Terms & Conditions checkbox option
  - Customizable title & subtitle underline accent
  - Collection picker, products limit, columns count selector (2, 3, 4, or 5 columns)
  - Customizable Sale Ribbon / Badge toggle (Show/Hide)
  - Hover Action Buttons: Add to Cart, Quick View (Search), Wishlist with smooth animation
  - 100% Mobile Responsive & Mobile Friendly
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">

{% style %}
  .bagkin-bestseller-section-{{ section.id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_bg_color | default: '#ffffff' }};
  }

  .bagkin-bestseller-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* --- SECTION HEADER & UNDERLINE --- */
  .bagkin-bestseller-header {
    text-align: center;
    margin-bottom: 45px;
  }

  .bagkin-bestseller-title {
    font-family: 'Jost', sans-serif;
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#000000' }};
    margin-bottom: 14px;
    letter-spacing: -0.5px;
  }

  .bagkin-bestseller-line {
    width: 60px;
    height: 3px;
    background-color: {{ section.settings.line_color | default: '#F0950A' }};
    margin: 0 auto;
    border-radius: 2px;
  }

  /* --- PRODUCT GRID LAYOUT --- */
  .bagkin-product-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: 30px;
  }

  /* --- PRODUCT CARD STYLES --- */
  .bagkin-product-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    position: relative;
    background: transparent;
  }

  /* Media / Image Box */
  .bagkin-product-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f7f7f7;
    overflow: hidden;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  .bagkin-product-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 20px;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bagkin-product-card:hover .bagkin-product-img {
    transform: scale(1.06);
  }

  /* Second Hover Image if Available */
  .bagkin-product-img-secondary {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.6s ease;
  }

  .bagkin-product-card:hover .bagkin-product-img-secondary {
    opacity: 1;
    transform: scale(1.06);
  }

  /* --- SALE RIBBON BADGE --- */
  .bagkin-sale-ribbon {
    position: absolute;
    top: 18px;
    right: -32px;
    background-color: {{ section.settings.sale_badge_bg | default: '#e63946' }};
    color: #ffffff;
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 34px;
    transform: rotate(45deg);
    z-index: 5;
    letter-spacing: 1px;
    text-transform: uppercase;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    pointer-events: none;
  }

  /* --- HOVER ACTION BUTTONS --- */
  .bagkin-hover-actions {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 6;
    opacity: 0;
    visibility: hidden;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bagkin-product-card:hover .bagkin-hover-actions {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .bagkin-action-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-color: #ffffff;
    color: #000000;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .bagkin-action-btn:hover {
    background-color: {{ section.settings.primary_accent | default: '#F0950A' }};
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(240, 149, 10, 0.3);
  }

  .bagkin-action-btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  /* --- COLOR SWATCHES --- */
  .bagkin-color-swatches {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 8px;
    margin-bottom: 10px;
  }

  .bagkin-swatch {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    cursor: pointer;
    border: 1px solid #ddd;
    position: relative;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .bagkin-swatch.is-active,
  .bagkin-swatch:hover {
    transform: scale(1.2);
    border-color: #000;
    box-shadow: 0 0 0 2px #fff, 0 0 0 3px #000;
  }

  /* --- PRODUCT INFO (TITLE & PRICE) --- */
  .bagkin-product-info {
    text-align: center;
    width: 100%;
  }

  .bagkin-product-title {
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #000000;
    margin-bottom: 6px;
    text-decoration: none;
    display: block;
    transition: color 0.3s ease;
  }

  .bagkin-product-card:hover .bagkin-product-title {
    color: {{ section.settings.primary_accent | default: '#F0950A' }};
  }

  .bagkin-product-price {
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .bagkin-price-sale {
    color: {{ section.settings.sale_price_color | default: '#F0950A' }};
    font-weight: 600;
  }

  .bagkin-price-regular {
    color: #888888;
    text-decoration: line-through;
    font-weight: 400;
  }

  .bagkin-price-normal {
    color: #333333;
    font-weight: 600;
  }

  /* --- QUICK VIEW MODAL POPUP STYLES --- */
  .bagkin-quickview-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.55);
    z-index: 2000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    backdrop-filter: blur(4px);
  }

  .bagkin-quickview-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .bagkin-quickview-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -45%) scale(0.95);
    width: 90%;
    max-width: 920px;
    max-height: 90vh;
    background-color: #ffffff;
    z-index: 2001;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bagkin-quickview-modal.is-open {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .bagkin-modal-close {
    position: absolute;
    top: 18px;
    right: 22px;
    background: none;
    border: none;
    font-size: 26px;
    cursor: pointer;
    color: #333333;
    z-index: 10;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .bagkin-modal-close:hover {
    color: {{ section.settings.primary_accent | default: '#F0950A' }};
    transform: scale(1.1);
  }

  .bagkin-modal-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 35px;
  }

  .bagkin-modal-media {
    background-color: #f7f7f7;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px;
    border-radius: 8px 0 0 8px;
  }

  .bagkin-modal-img {
    max-width: 100%;
    max-height: 440px;
    object-fit: contain;
  }

  .bagkin-modal-details {
    padding: 40px 40px 40px 0;
    display: flex;
    flex-direction: column;
    font-family: 'Jost', sans-serif;
  }

  .bagkin-modal-title {
    font-size: 28px;
    font-weight: 700;
    color: #000000;
    margin-bottom: 12px;
  }

  .bagkin-modal-price-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .bagkin-modal-sale-price {
    font-size: 26px;
    font-weight: 600;
    color: {{ section.settings.sale_price_color | default: '#F0950A' }};
  }

  .bagkin-modal-compare-price {
    font-size: 18px;
    color: #888888;
    text-decoration: line-through;
  }

  .bagkin-modal-save-tag {
    background-color: #e63946;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 12px;
    text-transform: uppercase;
  }

  .bagkin-modal-option-label {
    font-size: 14px;
    font-weight: 600;
    color: #333333;
    margin-bottom: 10px;
  }

  .bagkin-modal-option-label span {
    font-weight: 400;
    color: #666666;
  }

  .bagkin-modal-swatches {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
  }

  .bagkin-modal-swatch {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    border: 2px solid transparent;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .bagkin-modal-swatch.is-selected {
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px #000000;
  }

  .bagkin-modal-desc {
    font-size: 14px;
    line-height: 1.6;
    color: #777777;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid #eeeeee;
  }

  /* Scarcity Bar */
  .bagkin-scarcity-wrap {
    margin-bottom: 24px;
  }

  .bagkin-scarcity-text {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #333333;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .bagkin-scarcity-bar {
    width: 100%;
    height: 6px;
    background-color: #eee;
    border-radius: 3px;
    overflow: hidden;
  }

  .bagkin-scarcity-progress {
    width: 80%;
    height: 100%;
    background: linear-gradient(90deg, #000000 0%, #444444 100%);
    border-radius: 3px;
  }

  /* Quantity & Cart Actions */
  .bagkin-form-row {
    display: flex;
    gap: 15px;
    margin-bottom: 15px;
  }

  .bagkin-qty-selector {
    display: flex;
    align-items: center;
    border: 1px solid #cccccc;
    border-radius: 6px;
    padding: 0 8px;
    height: 48px;
  }

  .bagkin-qty-btn {
    background: none;
    border: none;
    font-size: 16px;
    cursor: pointer;
    padding: 0 8px;
    color: #555555;
  }

  .bagkin-qty-input {
    width: 35px;
    text-align: center;
    border: none;
    font-size: 15px;
    font-weight: 600;
    font-family: 'Jost', sans-serif;
  }

  .bagkin-add-btn {
    flex: 1;
    height: 48px;
    background-color: #ffffff;
    color: #000000;
    border: 1.5px solid #000000;
    border-radius: 6px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .bagkin-add-btn:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .bagkin-buy-now-btn {
    width: 100%;
    height: 48px;
    background-color: #777777;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    margin-bottom: 15px;
    transition: background-color 0.3s ease;
  }

  .bagkin-buy-now-btn:hover {
    background-color: #000000;
  }

  .bagkin-terms-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #555;
  }

  .bagkin-terms-wrap a {
    color: #000;
    text-decoration: underline;
  }

  /* --- RESPONSIVE MEDIA QUERIES --- */
  @media screen and (max-width: 1024px) {
    .bagkin-product-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet | default: 3 }}, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 768px) {
    .bagkin-product-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: '2' }}, 1fr);
      gap: 16px;
    }

    .bagkin-bestseller-title {
      font-size: 24px;
    }

    .bagkin-hover-actions {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
      bottom: 12px;
      gap: 8px;
    }

    .bagkin-action-btn {
      width: 38px;
      height: 38px;
    }

    .bagkin-action-btn svg {
      width: 16px;
      height: 16px;
    }

    .bagkin-modal-body {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .bagkin-modal-media {
      border-radius: 8px 8px 0 0;
      padding: 20px;
    }

    .bagkin-modal-details {
      padding: 0 20px 25px 20px;
    }
  }
{% endstyle %}

<div class="bagkin-bestseller-section-{{ section.id }}">
  <div class="bagkin-bestseller-container">
    {% if section.settings.title != blank %}
      <div class="bagkin-bestseller-header">
        <h2 class="bagkin-bestseller-title">{{ section.settings.title }}</h2>
        {% if section.settings.show_line %}
          <div class="bagkin-bestseller-line"></div>
        {% endif %}
      </div>
    {% endif %}

    <div class="bagkin-product-grid">
      {% assign selected_collection = collections[section.settings.collection] %}
      {% assign limit = section.settings.products_to_show | default: 8 %}

      {% if selected_collection != blank and selected_collection.products_count > 0 %}
        {% for product in selected_collection.products limit: limit %}
          <div
            class="bagkin-product-card"
            data-product-handle="{{ product.handle }}"
            data-product-title="{{ product.title | escape }}"
            data-product-price="{{ product.price | money }}"
            data-product-compare="{{ product.compare_at_price | money }}"
            data-product-img="{{ product.featured_image | image_url: width: 800 }}"
            data-product-desc="{{ product.description | strip_html | truncate: 150 | escape }}"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            data-product-images="{% assign img_urls = '' %}{% for img in product.images limit: 8 %}{% unless forloop.first %}|{% endunless %}{{ img | image_url: width: 800 }}{% endfor %}"
          >
            <div class="bagkin-product-media">
              {% comment %} Sale Badge Ribbon {% endcomment %}
              {% if section.settings.show_sale_badge and product.compare_at_price > product.price %}
                <span class="bagkin-sale-ribbon">Sale</span>
              {% endif %}

              {% comment %} Product Image {% endcomment %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.title | escape }}"
                class="bagkin-product-img"
                loading="lazy"
              >

              {% if product.images[1] != blank and section.settings.show_secondary_image %}
                <img
                  src="{{ product.images[1] | image_url: width: 600 }}"
                  alt="{{ product.title | escape }}"
                  class="bagkin-product-img-secondary"
                  loading="lazy"
                >
              {% endif %}

              {% comment %} Hover Action Buttons {% endcomment %}
              {% if section.settings.show_hover_actions %}
                <div class="bagkin-hover-actions">
                  {% if section.settings.show_cart_action %}
                    <form method="post" action="/cart/add" class="bagkin-add-to-cart-form">
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button type="submit" class="bagkin-action-btn" aria-label="Add to Cart" title="Add to Cart">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                          <line x1="3" y1="6" x2="21" y2="6"></line>
                          <path d="M16 10a4 4 0 0 1-8 0"></path>
                        </svg>
                      </button>
                    </form>
                  {% endif %}

                  {% if section.settings.show_quickview_action %}
                    <button type="button" class="bagkin-action-btn bagkin-trigger-quickview" aria-label="Quick View" title="Quick View">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      </svg>
                    </button>
                  {% endif %}

                  {% if section.settings.show_wishlist_action %}
                    <button type="button" class="bagkin-action-btn" aria-label="Add to Wishlist" title="Add to Wishlist">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                    </button>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            {% comment %} Real Color Swatches from product variants {% endcomment %}
            {% if section.settings.show_swatches %}
              <div class="bagkin-color-swatches">
                {% assign option_index = nil %}
                {% for option in product.options_with_values %}
                  {% assign option_down = option.name | downcase %}
                  {% if option_down == 'color' or option_down == 'colour' %}
                    {% assign option_index = forloop.index0 %}
                  {% endif %}
                {% endfor %}
                {% if option_index != nil %}
                  {% assign color_option = product.options_with_values[option_index] %}
                  {% for value in color_option.values limit: 5 %}
                    <span
                      class="bagkin-swatch {% if forloop.first %}is-active{% endif %}"
                      style="background-color: {{ value | downcase | replace: ' ', '' }};"
                      title="{{ value }}"
                      data-color="{{ value }}"
                    ></span>
                  {% endfor %}
                {% else %}
                  {% for variant in product.variants limit: 4 %}
                    <span
                      class="bagkin-swatch {% if forloop.first %}is-active{% endif %}"
                      style="background-color: {{ variant.title | downcase | replace: ' ', '' }};"
                      title="{{ variant.title }}"
                      data-color="{{ variant.title }}"
                    ></span>
                  {% endfor %}
                {% endif %}
              </div>
            {% endif %}

            <div class="bagkin-product-info">
              <a href="{{ product.url }}" class="bagkin-product-title">{{ product.title }}</a>
              <div class="bagkin-product-price">
                {% if product.compare_at_price > product.price %}
                  <span class="bagkin-price-sale">{{ product.price | money }}</span>
                  <span class="bagkin-price-regular">{{ product.compare_at_price | money }}</span>
                {% else %}
                  <span class="bagkin-price-normal">{{ product.price | money }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Placeholder Products -->
        {% for i in (1..limit) %}
          <div
            class="bagkin-product-card"
            data-product-title="Bella Bag"
            data-product-price="$60.00"
            data-product-compare="$70.00"
            data-product-img="https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-bag.png"
            data-product-desc="Cheer on your favorite red and white team in eye-popping style with these game bib overall bags! Each bag is made of 100 percent premium quality leather."
          >
            <div class="bagkin-product-media">
              {% if section.settings.show_sale_badge %}
                <span class="bagkin-sale-ribbon">Sale</span>
              {% endif %}

              {{ 'product-' | append: i | placeholder_svg_tag: 'bagkin-product-img' }}

              {% if section.settings.show_hover_actions %}
                <div class="bagkin-hover-actions">
                  {% if section.settings.show_cart_action %}
                    <button class="bagkin-action-btn" aria-label="Add to Cart">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                      </svg>
                    </button>
                  {% endif %}

                  {% if section.settings.show_quickview_action %}
                    <button type="button" class="bagkin-action-btn bagkin-trigger-quickview" aria-label="Quick View">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      </svg>
                    </button>
                  {% endif %}

                  {% if section.settings.show_wishlist_action %}
                    <button class="bagkin-action-btn" aria-label="Wishlist">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                    </button>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            {% comment %} Color Swatches on Card {% endcomment %}
            {% if section.settings.show_swatches %}
              <div class="bagkin-color-swatches">
                <span class="bagkin-swatch is-active" style="background-color: #d27d2d;" title="Bronze"></span>
                <span class="bagkin-swatch" style="background-color: #e6b800;" title="Mustard"></span>
                <span class="bagkin-swatch" style="background-color: #000000;" title="Black"></span>
              </div>
            {% endif %}

            <div class="bagkin-product-info">
              <span class="bagkin-product-title">
                {% cycle 'Amber Tote', 'Bella Bag', 'Chic Clutch', 'Dream Purse' %}
              </span>
              <div class="bagkin-product-price">
                <span class="bagkin-price-sale">$60.00</span>
                <span class="bagkin-price-regular">$80.00</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<!-- QUICK VIEW MODAL HTML CONTAINER -->
<div class="bagkin-quickview-overlay" id="bagkinQuickViewOverlay"></div>
<div class="bagkin-quickview-modal" id="bagkinQuickViewModal">
  <button class="bagkin-modal-close" id="bagkinModalClose">&times;</button>
  <div class="bagkin-modal-body">
    <div class="bagkin-modal-media" style="position:relative;">
      <!-- Gallery arrows -->
      <button id="bagkinModalImgPrev" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);z-index:5;background:rgba(0,0,0,0.4);color:#fff;border:none;border-radius:50%;width:36px;height:36px;font-size:20px;cursor:pointer;display:none;align-items:center;justify-content:center;">&lsaquo;</button>
      <img src="" alt="Product Image" id="bagkinModalImg" class="bagkin-modal-img">
      <button id="bagkinModalImgNext" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);z-index:5;background:rgba(0,0,0,0.4);color:#fff;border:none;border-radius:50%;width:36px;height:36px;font-size:20px;cursor:pointer;display:none;align-items:center;justify-content:center;">&rsaquo;</button>
    </div>
    <div class="bagkin-modal-details">
      <h2 class="bagkin-modal-title" id="bagkinModalTitle">Bella Bag</h2>
      <div class="bagkin-modal-price-wrap">
        <span class="bagkin-modal-sale-price" id="bagkinModalPrice">$60.00</span>
        <span class="bagkin-modal-compare-price" id="bagkinModalCompare">$70.00</span>
        <span class="bagkin-modal-save-tag">SAVE 14%</span>
      </div>

      <div class="bagkin-modal-option-label">Color: <span id="bagkinModalColorName">Bronze</span></div>
      <div class="bagkin-modal-swatches">
        <span class="bagkin-modal-swatch is-selected" style="background-color: #d27d2d;" data-color="Bronze"></span>
        <span class="bagkin-modal-swatch" style="background-color: #e6b800;" data-color="Mustard"></span>
        <span class="bagkin-modal-swatch" style="background-color: #000000;" data-color="Black"></span>
      </div>

      <p class="bagkin-modal-desc" id="bagkinModalDesc">
        Cheer on your favorite red and white team in eye-popping style with these red & white striped game bib overalls! Each pair is made of 100 percent cotton for a comfortable fit...
      </p>

      <div class="bagkin-scarcity-wrap">
        <div class="bagkin-scarcity-text">🔥 HURRY UP! ONLY 3 LEFT IN STOCK</div>
        <div class="bagkin-scarcity-bar">
          <div class="bagkin-scarcity-progress"></div>
        </div>
      </div>

      <div class="bagkin-form-row">
        <div class="bagkin-qty-selector">
          <button type="button" class="bagkin-qty-btn" id="bagkinQtyMinus">-</button>
          <input type="text" value="1" readonly class="bagkin-qty-input" id="bagkinQtyInput">
          <button type="button" class="bagkin-qty-btn" id="bagkinQtyPlus">+</button>
        </div>
        <button type="button" class="bagkin-add-btn" id="bagkinModalAddToCart">ADD TO CART</button>
      </div>

      <button type="button" class="bagkin-buy-now-btn">BUY IT NOW</button>

      <label class="bagkin-terms-wrap">
        <input type="checkbox" checked>
        I agree with <a href="#">TERMS & CONDITIONS</a>
      </label>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const overlay = document.getElementById('bagkinQuickViewOverlay');
    const modal = document.getElementById('bagkinQuickViewModal');
    const closeBtn = document.getElementById('bagkinModalClose');

    const modalTitle = document.getElementById('bagkinModalTitle');
    const modalPrice = document.getElementById('bagkinModalPrice');
    const modalCompare = document.getElementById('bagkinModalCompare');
    const modalImg = document.getElementById('bagkinModalImg');
    const modalDesc = document.getElementById('bagkinModalDesc');
    const imgPrev = document.getElementById('bagkinModalImgPrev');
    const imgNext = document.getElementById('bagkinModalImgNext');

    let galleryImages = [];
    let galleryIndex = 0;
    let currentVariantId = null;

    // --- CSS color name fallback map ---
    const colorMap = {
      'bronze':'#cd7f32','burgundy':'#800020','black':'#000000','white':'#ffffff',
      'red':'#cc0000','blue':'#1a56db','navy':'#001f5b','green':'#1a7a1a',
      'yellow':'#e6b800','mustard':'#e6b800','gold':'#cfa524','pink':'#e75480',
      'purple':'#6a0dad','orange':'#e8600a','grey':'#888888','gray':'#888888',
      'brown':'#7b4f28','beige':'#d4b896','cream':'#f5f0e8','tan':'#d2b48c',
      'silver':'#aaaaaa','camel':'#c19a6b','nude':'#e3bc9a','rust':'#b7410e',
      'teal':'#008080','olive':'#808000','lilac':'#c8a2c8','rose':'#ff007f',
    };

    // Fix card swatch colors using map
    document.querySelectorAll('.bagkin-swatch').forEach(sw => {
      const raw = (sw.getAttribute('title') || '').toLowerCase().trim().replace(/\s+/g, '');
      const mapped = colorMap[raw];
      if (mapped) sw.style.backgroundColor = mapped;
    });

    // Gallery navigation
    function setGalleryImage(idx) {
      if (!galleryImages.length) return;
      if (idx < 0) idx = galleryImages.length - 1;
      if (idx >= galleryImages.length) idx = 0;
      galleryIndex = idx;
      modalImg.src = galleryImages[galleryIndex];
      const showArrows = galleryImages.length > 1;
      if (imgPrev) imgPrev.style.display = showArrows ? 'flex' : 'none';
      if (imgNext) imgNext.style.display = showArrows ? 'flex' : 'none';
    }

    if (imgPrev) imgPrev.addEventListener('click', () => setGalleryImage(galleryIndex - 1));
    if (imgNext) imgNext.addEventListener('click', () => setGalleryImage(galleryIndex + 1));

    // Open Quick View Modal — fetch full product data via Shopify AJAX API
    document.querySelectorAll('.bagkin-trigger-quickview').forEach(button => {
      button.addEventListener('click', function (e) {
        e.preventDefault();
        const card = this.closest('.bagkin-product-card');

        const title = card.getAttribute('data-product-title') || '';
        const price = card.getAttribute('data-product-price') || '';
        const compare = card.getAttribute('data-product-compare') || '';
        const desc = card.getAttribute('data-product-desc') || '';
        const fallbackImg = card.getAttribute('data-product-img') || '';
        const handle = card.getAttribute('data-product-handle') || '';
        currentVariantId = card.getAttribute('data-variant-id');

        modalTitle.textContent = title;
        modalPrice.textContent = price;
        modalCompare.textContent = compare;
        if (modalCompare) modalCompare.style.display = compare && compare !== price ? 'inline' : 'none';
        if (modalDesc) modalDesc.textContent = desc;
        document.getElementById('bagkinQtyInput').value = 1;

        // Set initial image immediately, then fetch gallery
        galleryImages = [fallbackImg];
        setGalleryImage(0);

        overlay.classList.add('is-open');
        modal.classList.add('is-open');
        document.body.style.overflow = 'hidden';

        // Fetch full product images from Shopify
        if (handle) {
          fetch('/products/' + handle + '.js')
            .then(r => r.json())
            .then(p => {
              if (p.images && p.images.length > 0) {
                galleryImages = p.images.map(img => img.replace(/\.jpg|\.(png|gif|webp)/i, m => '_800x' + m));
                setGalleryImage(0);
              }
              // Update swatches in modal dynamically
              const swatchContainer = document.querySelector('.bagkin-modal-swatches');
              const colorLabel = document.getElementById('bagkinModalColorName');
              if (swatchContainer && p.options) {
                const colorOpt = p.options.find(o => o.name.toLowerCase() === 'color' || o.name.toLowerCase() === 'colour');
                if (colorOpt && colorOpt.values) {
                  swatchContainer.innerHTML = '';
                  colorOpt.values.slice(0, 6).forEach((val, i) => {
                    const sp = document.createElement('span');
                    sp.className = 'bagkin-modal-swatch' + (i === 0 ? ' is-selected' : '');
                    const key = val.toLowerCase().replace(/\s+/g, '');
                    sp.style.backgroundColor = colorMap[key] || val.toLowerCase();
                    sp.setAttribute('data-color', val);
                    sp.addEventListener('click', function() {
                      swatchContainer.querySelectorAll('.bagkin-modal-swatch').forEach(s => s.classList.remove('is-selected'));
                      this.classList.add('is-selected');
                      if (colorLabel) colorLabel.textContent = this.getAttribute('data-color');
                    });
                    swatchContainer.appendChild(sp);
                  });
                  if (colorLabel) colorLabel.textContent = colorOpt.values[0];
                }
              }
            })
            .catch(() => {});
        }
      });
    });

    function closeModal() {
      overlay.classList.remove('is-open');
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (overlay) overlay.addEventListener('click', closeModal);

    // Color Swatches interaction in Modal (static fallback)
    const colorLabel = document.getElementById('bagkinModalColorName');
    document.querySelectorAll('.bagkin-modal-swatch').forEach(swatch => {
      swatch.addEventListener('click', function () {
        document.querySelectorAll('.bagkin-modal-swatch').forEach(s => s.classList.remove('is-selected'));
        this.classList.add('is-selected');
        if (colorLabel) colorLabel.textContent = this.getAttribute('data-color');
      });
    });

    // Quantity Counter Logic
    const qtyInput = document.getElementById('bagkinQtyInput');
    const qtyMinus = document.getElementById('bagkinQtyMinus');
    const qtyPlus = document.getElementById('bagkinQtyPlus');

    if (qtyMinus && qtyPlus && qtyInput) {
      qtyMinus.addEventListener('click', function () {
        let val = parseInt(qtyInput.value) || 1;
        if (val > 1) qtyInput.value = val - 1;
      });
      qtyPlus.addEventListener('click', function () {
        let val = parseInt(qtyInput.value) || 1;
        qtyInput.value = val + 1;
      });
    }

    // --- ADD TO CART via AJAX ---
    const addToCartBtn = document.getElementById('bagkinModalAddToCart');
    if (addToCartBtn) {
      addToCartBtn.addEventListener('click', function () {
        if (!currentVariantId) return;
        const qty = parseInt(document.getElementById('bagkinQtyInput').value) || 1;
        addToCartBtn.textContent = 'ADDING...';
        addToCartBtn.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: parseInt(currentVariantId), quantity: qty })
        })
        .then(r => r.json())
        .then(data => {
          if (data.status) {
            addToCartBtn.textContent = 'ERROR!';
          } else {
            addToCartBtn.textContent = 'ADDED!';
            // Update cart badge count
            fetch('/cart.js')
              .then(r => r.json())
              .then(cart => {
                document.querySelectorAll('.bagkin-cart-badge').forEach(b => { b.textContent = cart.item_count; });
              });
          }
          setTimeout(() => { addToCartBtn.textContent = 'ADD TO CART'; addToCartBtn.disabled = false; }, 1800);
        })
        .catch(() => { addToCartBtn.textContent = 'ADD TO CART'; addToCartBtn.disabled = false; });
      });
    }

    // --- Hover card Add to Cart forms (AJAX) ---
    document.querySelectorAll('.bagkin-add-to-cart-form').forEach(form => {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        const id = form.querySelector('input[name="id"]').value;
        const btn = form.querySelector('button[type="submit"]');
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: parseInt(id), quantity: 1 })
        }).then(r => r.json()).then(data => {
          if (!data.status) {
            fetch('/cart.js').then(r => r.json()).then(cart => {
              document.querySelectorAll('.bagkin-cart-badge').forEach(b => { b.textContent = cart.item_count; });
            });
          }
        }).catch(() => {});
      });
    });
  });
</script>

{% schema %}
{
  "name": "Bagkin Best Seller Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Title Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Best Seller"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "show_line",
      "label": "Show Underline Accent",
      "default": true
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Underline Color",
      "default": "#F0950A"
    },
    {
      "type": "header",
      "content": "Collection & Grid Layout Settings"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products to Show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Tablet",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ],
      "default": "2",
      "label": "Columns on Mobile"
    },
    {
      "type": "header",
      "content": "Product Card Features"
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show Sale Ribbon Badge",
      "default": true
    },
    {
      "type": "color",
      "id": "sale_badge_bg",
      "label": "Sale Badge Background",
      "default": "#e63946"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show Color Swatches under Card",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show Secondary Image on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Hover Action Icons (Cart, Quick View, Wishlist)"
    },
    {
      "type": "checkbox",
      "id": "show_hover_actions",
      "label": "Show Hover Actions Container",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_action",
      "label": "Show Add to Cart Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quickview_action",
      "label": "Show Search / Quick View Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist_action",
      "label": "Show Wishlist Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "primary_accent",
      "label": "Primary Accent Color (Hover)",
      "default": "#F0950A"
    },
    {
      "type": "color",
      "id": "sale_price_color",
      "label": "Sale Price Color",
      "default": "#F0950A"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Bagkin Best Seller Grid"
    }
  ]
}
{% endschema %}
