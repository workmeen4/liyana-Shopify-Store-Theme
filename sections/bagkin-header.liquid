<header class="bagkin-header-standalone" id="bagkinHeaderStandalone">
  <div class="bagkin-header-inner">
    <div class="bagkin-logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo_image != blank %}
          <img
            src="{{ section.settings.logo_image | image_url: width: 600 }}"
            alt="{{ shop.name }}"
            class="bagkin-logo-img"
            loading="eager"
          >
        {% else %}
          <span class="bagkin-logo-text">{{ section.settings.logo_text | default: shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <nav class="bagkin-nav">
      <ul class="bagkin-nav-list">
        {% assign main_menu = linklists[section.settings.menu_linklist] %}
        {% if main_menu.links.size > 0 %}
          {% for link in main_menu.links %}
            <li class="bagkin-nav-item"><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        {% else %}
          <li class="bagkin-nav-item"><a href="#">HOME</a></li>
          <li class="bagkin-nav-item"><a href="#">SHOPS</a></li>
          <li class="bagkin-nav-item"><a href="#">PRODUCTS</a></li>
          <li class="bagkin-nav-item"><a href="#">BLOG</a></li>
          <li class="bagkin-nav-item"><a href="#">PAGES</a></li>
        {% endif %}
      </ul>
    </nav>

    <div class="bagkin-actions">
      {% if section.settings.show_search_icon %}
        <a href="{{ routes.search_url }}" class="bagkin-icon-btn bagkin-icon-search" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.show_account_icon %}
        <a href="{{ routes.account_url }}" class="bagkin-icon-btn bagkin-icon-account" aria-label="Account">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.show_wishlist_icon %}
        <a href="#" class="bagkin-icon-btn bagkin-icon-wishlist" aria-label="Wishlist">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.show_cart_icon %}
        <a href="{{ routes.cart_url }}" class="bagkin-icon-btn bagkin-icon-cart" aria-label="Cart">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="bagkin-cart-badge">{{ cart.item_count | default: 0 }}</span>
        </a>
      {% endif %}

      <button class="bagkin-hamburger" id="bagkinStandaloneHamburger" aria-label="Toggle Menu">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Spacer so page content is not hidden under fixed header -->
<div class="bagkin-header-spacer" aria-hidden="true"></div>

<!-- MOBILE DRAWER -->
<div class="bagkin-mobile-overlay" id="bagkinStandaloneOverlay"></div>
<div class="bagkin-mobile-menu" id="bagkinStandaloneMobileMenu">
  <div class="bagkin-mobile-header">
    <span class="bagkin-logo-text" style="color:#000;">{{ section.settings.logo_text | default: shop.name }}</span>
    <button class="bagkin-close-btn" id="bagkinStandaloneCloseBtn">&times;</button>
  </div>
  <nav class="bagkin-mobile-nav">
    {% assign main_menu = linklists[section.settings.menu_linklist] %}
    {% if main_menu.links.size > 0 %}
      {% for link in main_menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    {% else %}
      <a href="#">HOME</a>
      <a href="#">SHOPS</a>
      <a href="#">PRODUCTS</a>
      <a href="#">BLOG</a>
      <a href="#">PAGES</a>
    {% endif %}
  </nav>
</div>

<!-- CART DRAWER -->
<div class="bagkin-cart-drawer" id="bagkinCartDrawer">
  <div class="bagkin-cart-header">
    <h2 class="bagkin-cart-title">Shopping Cart</h2>
    <button class="bagkin-cart-close" id="bagkinCartCloseBtn">&times;</button>
  </div>
  
  <form action="{{ routes.cart_url }}" method="post" id="cart" class="bagkin-cart-body" style="padding:0;">
    {% if cart.item_count == 0 %}
      <div class="bagkin-cart-empty">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8zm-9-3.3l6.5 3.6-2.5 1.4-6.5-3.6 2.5-1.4zM4.3 9.4l4.2 2.3v5.6L4.3 15V9.4zm5.7 8.3v-5.6l2 1.1v5.6l-2-1.1zm3 1.6l-2-1.1v-5.6l2 1.1v5.6zm1-6.1l-6.5-3.6 2.5-1.4 6.5 3.6-2.5 1.4zm5.7-1.4v5.6l-4.2 2.3v-5.6l4.2-2.3z"/></svg>
        <h3>Your cart is empty</h3>
        <p>You may check out all the available products and buy some in the shop.</p>
        <a href="{{ routes.all_products_collection_url }}" class="bagkin-btn">CONTINUE SHOPPING</a>
      </div>
    {% else %}
      <div style="padding: 24px; flex: 1; overflow-y: auto;">
        <div class="bagkin-shipping-bar">
          <div class="bagkin-shipping-text">Congrats! You are eligible for FREE Shipping</div>
          <div class="bagkin-shipping-progress">
            <div class="bagkin-shipping-progress-inner"></div>
            <div class="bagkin-shipping-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 17.27l-5.18 3.73 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.73 1.64 7.03L12 17.27z"/></svg>
            </div>
          </div>
        </div>

        <div class="bagkin-cart-items">
          {% for item in cart.items %}
            <div class="bagkin-cart-item">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 200 }}" class="bagkin-cart-item-img" alt="{{ item.title | escape }}">
              {% endif %}
              <div class="bagkin-cart-item-info">
                <div>
                  <a href="{{ item.url }}" class="bagkin-cart-item-title">{{ item.product.title }}</a>
                  <p class="bagkin-cart-item-price">{{ item.final_line_price | money }}</p>
                </div>
                <div class="bagkin-cart-item-actions">
                  <div class="bagkin-qty-selector">
                    <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="bagkin-qty-btn">&minus;</a>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" class="bagkin-qty-input" min="0">
                    <a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="bagkin-qty-btn">&plus;</a>
                  </div>
                  <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="bagkin-cart-item-remove">Remove</a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.upsell_collection != blank %}
          <div class="bagkin-cart-upsell">
            <h4>You may also like</h4>
            {% assign u_col = collections[section.settings.upsell_collection] %}
            {% if u_col.products.size > 0 %}
              <div class="bagkin-upsell-item">
                <img src="{{ u_col.products.first.featured_image | image_url: width: 200 }}" class="bagkin-upsell-img" alt="">
                <div class="bagkin-upsell-info">
                  <a href="{{ u_col.products.first.url }}" class="bagkin-upsell-title">{{ u_col.products.first.title }}</a>
                  <p class="bagkin-upsell-price">
                    {{ u_col.products.first.price | money }} 
                    {% if u_col.products.first.compare_at_price > u_col.products.first.price %}
                      <span class="bagkin-upsell-compare">{{ u_col.products.first.compare_at_price | money }}</span>
                    {% endif %}
                  </p>
                  <a href="{{ u_col.products.first.url }}" class="bagkin-upsell-add">+ Add to Cart</a>
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="bagkin-cart-footer">
        <label class="bagkin-order-note" for="CartNote">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          Add order note
        </label>
        
        <div class="bagkin-cart-totals">
          <span>Total</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="bagkin-cart-tax">Taxes and <a href="/policies/shipping-policy">shipping</a> calculated at checkout</p>
        
        <div class="bagkin-cart-buttons">
          <button type="submit" name="checkout" class="bagkin-btn-checkout">Check Out</button>
          <a href="{{ routes.cart_url }}" class="bagkin-btn-viewcart">View Cart</a>
        </div>
      </div>
    {% endif %}
  </form>
</div>

<script>
  (function () {
    var header = document.getElementById('bagkinHeaderStandalone');
    if (!header) return;

    function getScroll() {
      // 1. Try standard window scroll
      var scrollY = window.scrollY !== undefined ? window.scrollY
           : window.pageYOffset !== undefined ? window.pageYOffset
           : document.documentElement.scrollTop || document.body.scrollTop || 0;
           
      // 2. If 0, check spacer position (foolproof for wrapper-scroll themes)
      if (scrollY === 0) {
        var spacer = document.querySelector('.bagkin-header-spacer');
        if (spacer) {
          var rectTop = spacer.getBoundingClientRect().top;
          if (rectTop < 0) {
            scrollY = Math.abs(rectTop);
          }
        }
      }
      return scrollY;
    }

    function updateSpacerHeight() {
      var h = header.offsetHeight;
      document.querySelectorAll('.bagkin-header-spacer').forEach(function(el) {
        el.style.height = h + 'px';
      });
    }

    function handleScroll() {
      if (getScroll() > 30) {
        header.classList.add('is-sticky');
      } else {
        header.classList.remove('is-sticky');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    document.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', updateSpacerHeight, { passive: true });

    /* rAF polling â€” bulletproof fallback */
    var _last = -1;
    (function poll() {
      var s = getScroll();
      if (s !== _last) { _last = s; handleScroll(); }
      requestAnimationFrame(poll);
    })();

    handleScroll();
    updateSpacerHeight();

    /* Mobile menu */
    var hamburger  = document.getElementById('bagkinStandaloneHamburger');
    var closeBtn   = document.getElementById('bagkinStandaloneCloseBtn');
    var mobileMenu = document.getElementById('bagkinStandaloneMobileMenu');
    var overlay    = document.getElementById('bagkinStandaloneOverlay');

    function openMenu()  { if(mobileMenu) mobileMenu.classList.add('is-active');    if(overlay) overlay.classList.add('is-active'); }
    function closeMenu() { if(mobileMenu) mobileMenu.classList.remove('is-active'); if(overlay) overlay.classList.remove('is-active'); }

    if (hamburger) hamburger.addEventListener('click', openMenu);
    if (closeBtn)  closeBtn.addEventListener('click', closeMenu);
    if (overlay)   overlay.addEventListener('click', closeMenu);

    /* Cart drawer */
    var cartIcon = document.querySelector('.bagkin-icon-cart');
    var cartDrawer = document.getElementById('bagkinCartDrawer');
    var cartClose = document.getElementById('bagkinCartCloseBtn');
    
    function openCart(e) {
      if(e) e.preventDefault();
      if(cartDrawer) cartDrawer.classList.add('is-active');
      if(overlay) overlay.classList.add('is-active');
    }
    function closeCart() {
      if(cartDrawer) cartDrawer.classList.remove('is-active');
      if(overlay) overlay.classList.remove('is-active');
    }
    
    if(cartIcon) cartIcon.addEventListener('click', openCart);
    if(cartClose) cartClose.addEventListener('click', closeCart);
    if(overlay) overlay.addEventListener('click', closeCart);
  })();
</script>

{% schema %}
{
  "name": "Bagkin Header Only",
  "settings": [
    { "type": "header", "content": "Theme Colors & Branding" },
    { "type": "color", "id": "primary_color", "label": "Primary Accent Color", "default": "#F0950A" },
    { "type": "color", "id": "header_bg", "label": "Header Initial Background", "default": "#EAE6DF" },
    { "type": "color", "id": "header_text_color", "label": "Header Initial Text Color", "default": "#000000" },
    { "type": "color", "id": "sticky_header_bg", "label": "Sticky Header Background (On Scroll)", "default": "#ffffff" },
    { "type": "color", "id": "sticky_text_color", "label": "Sticky Header Text Color (On Scroll)", "default": "#000000" },
    { "type": "header", "content": "Logo Settings" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo Image" },
    { "type": "range", "id": "logo_width", "min": 50, "max": 350, "step": 5, "unit": "px", "label": "Desktop Logo Width", "default": 160 },
    { "type": "number", "id": "logo_height", "label": "Logo Height (px, blank = auto)" },
    { "type": "range", "id": "mobile_logo_width", "min": 40, "max": 220, "step": 5, "unit": "px", "label": "Mobile Logo Width", "default": 120 },
    { "type": "text", "id": "logo_text", "label": "Logo Text (Fallback)", "default": "BAGKIN" },
    { "type": "header", "content": "Header Menu & Icons" },
    { "type": "link_list", "id": "menu_linklist", "label": "Header Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search_icon", "label": "Show Search Icon", "default": true },
    { "type": "checkbox", "id": "show_account_icon", "label": "Show Account Icon", "default": true },
    { "type": "checkbox", "id": "show_wishlist_icon", "label": "Show Wishlist Icon", "default": true },
    { "type": "checkbox", "id": "show_cart_icon", "label": "Show Cart Icon", "default": true },
        { "type": "checkbox", "id": "mobile_show_search_cart_only", "label": "Mobile: Show Search & Cart Only", "default": true },
    { "type": "header", "content": "Cart Drawer Settings" },
    { "type": "collection", "id": "upsell_collection", "label": "Upsell Collection (You may also like)" }
  ],
  "presets": [{ "name": "Bagkin Header Only" }]
}
{% endschema %}

