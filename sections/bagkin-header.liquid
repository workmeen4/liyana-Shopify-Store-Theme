{% comment %}
  Bagkin Standalone Custom Header Section
  - Mobile friendly & 100% responsive
  - Custom font family Jost loaded via Google Fonts
  - Sticky header on scroll with smooth animation
  - Customizable background colors & text colors
  - Customizable logo width & height
  - Toggle switches for Search, Account, Wishlist & Cart icons
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
  /* ============================================================
     BAGKIN HEADER â€” All CSS in a raw style tag
     Reason: Shopify scopes selectors with #shopify-section-ID
     which breaks position:fixed elements on desktop.
  ============================================================ */
  :root {
    --bagkin-font: 'Jost', sans-serif;
    --bagkin-primary: {{ section.settings.primary_color | default: '#F0950A' }};
    --bagkin-header-bg: {{ section.settings.header_bg | default: '#EAE6DF' }};
    --bagkin-header-text: {{ section.settings.header_text_color | default: '#000000' }};
    --bagkin-sticky-bg: {{ section.settings.sticky_header_bg | default: '#ffffff' }};
    --bagkin-sticky-text: {{ section.settings.sticky_text_color | default: '#000000' }};
    --bagkin-logo-width: {{ section.settings.logo_width | default: 160 }}px;
    --bagkin-mobile-logo-width: {{ section.settings.mobile_logo_width | default: 120 }}px;
  }

  .bagkin-header-standalone * {
    font-family: var(--bagkin-font);
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* --- BASE HEADER --- */
  .bagkin-header-standalone {
    width: 100%;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background-color: var(--bagkin-header-bg);
    transition: background-color 0.4s ease, box-shadow 0.4s ease;
  }

  .bagkin-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 5%;
    width: 100%;
    transition: padding 0.3s ease;
  }

  /* --- STICKY STATE --- */
  .bagkin-header-standalone.is-sticky {
    background-color: var(--bagkin-sticky-bg) !important;
    box-shadow: 0 4px 20px rgba(0,0,0,0.10) !important;
    border-bottom: 1px solid rgba(0,0,0,0.06) !important;
  }

  .bagkin-header-standalone.is-sticky .bagkin-header-inner {
    padding: 14px 5% !important;
  }

  .bagkin-header-standalone.is-sticky .bagkin-nav-item a,
  .bagkin-header-standalone.is-sticky .bagkin-icon-btn,
  .bagkin-header-standalone.is-sticky .bagkin-logo-text,
  .bagkin-header-standalone.is-sticky .bagkin-hamburger {
    color: var(--bagkin-sticky-text) !important;
  }

  .bagkin-header-standalone.is-sticky .bagkin-icon-btn svg {
    stroke: var(--bagkin-sticky-text) !important;
  }

  /* --- SPACER --- */
  .bagkin-header-spacer { height: 80px; }
  @media screen and (max-width: 768px) {
    .bagkin-header-spacer { height: 66px; }
  }

  /* --- LOGO --- */
  .bagkin-logo a { text-decoration: none; display: flex; align-items: center; }

  .bagkin-logo-img {
    width: var(--bagkin-logo-width);
    height: {% if section.settings.logo_height != blank %}{{ section.settings.logo_height }}px{% else %}auto{% endif %};
    max-width: 100%;
    object-fit: contain;
  }

  .bagkin-logo-text {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--bagkin-header-text);
    text-transform: uppercase;
  }

  /* --- NAV --- */
  .bagkin-nav { display: flex; align-items: center; gap: 36px; }
  .bagkin-nav-list { display: flex; list-style: none; gap: 32px; align-items: center; }

  .bagkin-nav-item a {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--bagkin-header-text);
    text-decoration: none;
    position: relative;
    padding: 4px 0;
    transition: color 0.3s ease;
  }

  .bagkin-nav-item a::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0; height: 2px;
    background-color: var(--bagkin-primary);
    transition: width 0.3s ease;
  }

  .bagkin-nav-item a:hover { color: var(--bagkin-primary); }
  .bagkin-nav-item a:hover::after { width: 100%; }

  /* --- ICONS --- */
  .bagkin-actions { display: flex; align-items: center; gap: 20px; }

  .bagkin-icon-btn {
    background: none; border: none; cursor: pointer;
    color: var(--bagkin-header-text);
    position: relative;
    display: flex; align-items: center; justify-content: center;
    padding: 6px;
    transition: transform 0.2s ease, color 0.3s ease;
    text-decoration: none;
  }

  .bagkin-icon-btn:hover { color: var(--bagkin-primary); transform: translateY(-2px); }

  .bagkin-icon-btn svg {
    width: 22px; height: 22px;
    stroke: currentColor; fill: none; stroke-width: 1.8;
  }

  .bagkin-cart-badge {
    position: absolute; top: -2px; right: -4px;
    background-color: var(--bagkin-primary);
    color: #fff; font-size: 11px; font-weight: 600;
    width: 18px; height: 18px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }

  /* --- HAMBURGER --- */
  .bagkin-hamburger {
    display: none; background: none; border: none;
    cursor: pointer; padding: 6px;
    color: var(--bagkin-header-text);
  }
  .bagkin-hamburger svg { width: 26px; height: 26px; stroke: currentColor; }

  /* --- MOBILE DRAWER --- */
  .bagkin-mobile-menu {
    position: fixed; top: 0; left: -100%;
    width: 80%; max-width: 320px; height: 100vh;
    background-color: #fff;
    z-index: 99999;
    box-shadow: 4px 0 25px rgba(0,0,0,0.15);
    transition: left 0.4s ease;
    padding: 30px 24px;
    display: flex; flex-direction: column; overflow-y: auto;
  }
  .bagkin-mobile-menu.is-active { left: 0; }

  .bagkin-mobile-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 30px; padding-bottom: 15px;
    border-bottom: 1px solid #eee;
  }

  .bagkin-close-btn {
    background: none; border: none;
    font-size: 28px; line-height: 1; cursor: pointer;
    color: #000; padding: 4px 8px; border-radius: 4px;
    transition: background 0.2s ease;
    position: relative; z-index: 100000;
  }
  .bagkin-close-btn:hover { background: rgba(0,0,0,0.08); }

  .bagkin-mobile-nav { display: flex; flex-direction: column; gap: 20px; }
  .bagkin-mobile-nav a {
    font-size: 16px; font-weight: 600; letter-spacing: 1px;
    text-transform: uppercase; color: #000; text-decoration: none;
  }

  .bagkin-mobile-overlay {
    position: fixed; top: 0; left: 0;
    width: 100vw; height: 100vh;
    background-color: rgba(0,0,0,0.5);
    z-index: 99998; opacity: 0; visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .bagkin-mobile-overlay.is-active { opacity: 1; visibility: visible; }

  /* --- RESPONSIVE --- */
  @media screen and (max-width: 991px) {
    .bagkin-nav { display: none; }
    .bagkin-hamburger { display: block; }
    .bagkin-logo-img { width: var(--bagkin-mobile-logo-width); }
    {% if section.settings.mobile_show_search_cart_only %}
      .bagkin-icon-account, .bagkin-icon-wishlist { display: none !important; }
    {% endif %}
  }

  @media screen and (max-width: 480px) {
    .bagkin-header-inner { padding: 16px 4%; }
    .bagkin-logo-text { font-size: 24px; }
  }
  /* --- CART DRAWER --- */
  .bagkin-cart-drawer {
    position: fixed; top: 0; right: -100%;
    width: 90%; max-width: 400px; height: 100vh;
    background-color: #fff;
    z-index: 99999;
    box-shadow: -4px 0 25px rgba(0,0,0,0.15);
    transition: right 0.4s ease;
    display: flex; flex-direction: column;
  }
  .bagkin-cart-drawer.is-active { right: 0; }
  
  .bagkin-cart-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 24px; border-bottom: 1px solid #eee;
  }
  .bagkin-cart-title { font-size: 22px; font-weight: 600; margin: 0; color: #000; }
  .bagkin-cart-close {
    background: none; border: none; font-size: 24px; cursor: pointer; color: #000;
  }
  
  .bagkin-cart-body {
    flex: 1; overflow-y: auto; padding: 24px;
    display: flex; flex-direction: column;
  }
  
  /* Empty State */
  .bagkin-cart-empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; height: 100%; gap: 20px; padding: 20px;
  }
  .bagkin-cart-empty svg { width: 80px; height: 80px; fill: #ddd; }
  .bagkin-cart-empty h3 { font-size: 24px; font-weight: 600; margin: 0; }
  .bagkin-cart-empty p { font-size: 14px; color: #666; margin: 0; line-height: 1.5; }
  .bagkin-cart-empty .bagkin-btn {
    background: #000; color: #fff; text-transform: uppercase; font-weight: 600;
    padding: 12px 24px; border-radius: 4px; text-decoration: none; font-size: 14px;
    margin-top: 10px; display: inline-block;
  }

  /* Filled State */
  .bagkin-shipping-bar { margin-bottom: 20px; }
  .bagkin-shipping-text { font-size: 13px; color: #333; margin-bottom: 8px; }
  .bagkin-shipping-progress {
    width: 100%; height: 4px; background: #eee; border-radius: 2px; position: relative;
  }
  .bagkin-shipping-progress-inner {
    height: 100%; background: #000; border-radius: 2px; width: 100%;
  }
  .bagkin-shipping-icon {
    position: absolute; right: 0; top: 50%; transform: translate(50%, -50%);
    background: #000; color: #fff; width: 24px; height: 24px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  .bagkin-shipping-icon svg { width: 14px; height: 14px; fill: currentColor; }

  .bagkin-cart-items { display: flex; flex-direction: column; gap: 20px; }
  .bagkin-cart-item { display: flex; gap: 16px; padding-bottom: 20px; border-bottom: 1px solid #eee; }
  .bagkin-cart-item-img { width: 80px; height: 80px; object-fit: cover; background: #f5f5f5; border-radius: 4px; }
  .bagkin-cart-item-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
  .bagkin-cart-item-title { font-size: 15px; font-weight: 600; color: #000; text-decoration: none; margin: 0 0 4px 0; display: block; }
  .bagkin-cart-item-price { font-size: 14px; color: #000; margin: 0 0 10px 0; }
  .bagkin-cart-item-actions { display: flex; justify-content: space-between; align-items: center; }
  
  .bagkin-qty-selector {
    display: flex; align-items: center; border: 1px solid #ddd; border-radius: 4px; overflow: hidden;
  }
  .bagkin-qty-btn {
    background: #fff; border: none; width: 28px; height: 28px; display: flex;
    align-items: center; justify-content: center; cursor: pointer; font-size: 16px; color: #666;
  }
  .bagkin-qty-input {
    width: 32px; height: 28px; border: none; text-align: center; font-size: 13px; font-weight: 600;
    pointer-events: none; -moz-appearance: textfield;
  }
  
  .bagkin-cart-item-remove { font-size: 12px; color: #999; text-decoration: underline; }

  /* Upsell */
  .bagkin-cart-upsell { margin-top: 30px; }
  .bagkin-cart-upsell h4 { font-size: 16px; font-weight: 600; margin: 0 0 16px 0; }
  .bagkin-upsell-item { display: flex; gap: 16px; align-items: center; }
  .bagkin-upsell-img { width: 70px; height: 70px; object-fit: cover; background: #f5f5f5; border-radius: 4px; }
  .bagkin-upsell-info { flex: 1; }
  .bagkin-upsell-title { font-size: 14px; font-weight: 600; margin: 0 0 4px 0; display: block; text-decoration: none; color: #000; }
  .bagkin-upsell-price { font-size: 13px; color: #f0950a; margin: 0 0 6px 0; }
  .bagkin-upsell-compare { color: #999; text-decoration: line-through; margin-left: 6px; font-size: 12px; }
  .bagkin-upsell-add { font-size: 12px; color: #666; text-decoration: underline; }

  .bagkin-cart-footer { padding: 24px; border-top: 1px solid #eee; background: #fff; }
  .bagkin-order-note {
    display: flex; align-items: center; gap: 8px; font-size: 13px; color: #666; margin-bottom: 20px; cursor: pointer;
  }
  .bagkin-cart-totals { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .bagkin-cart-totals span { font-size: 16px; font-weight: 600; color: #000; }
  .bagkin-cart-totals strong { font-size: 18px; font-weight: 700; color: #000; }
  .bagkin-cart-tax { font-size: 12px; color: #666; margin: 0 0 20px 0; }
  .bagkin-cart-tax a { color: #0000ee; }
  
  .bagkin-cart-buttons { display: flex; flex-direction: column; gap: 10px; }
  .bagkin-btn-checkout {
    background: #000; color: #fff; text-align: center; padding: 14px;
    font-weight: 600; text-transform: uppercase; text-decoration: none; border-radius: 4px;
  }
  .bagkin-btn-viewcart {
    background: #fff; color: #000; text-align: center; padding: 14px; border: 1px solid #000;
    font-weight: 600; text-transform: uppercase; text-decoration: none; border-radius: 4px;
  }
  /* --- CART DRAWER --- */
  .bagkin-cart-drawer {
    position: fixed; top: 0; right: -100%;
    width: 90%; max-width: 400px; height: 100vh;
    background-color: #fff;
